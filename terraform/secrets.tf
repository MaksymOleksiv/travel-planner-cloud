# JWT signing key: generated by Terraform, stored in Secrets Manager,
# injected into the container by ECS as JWT_SECRET. Never in git or in the image.
resource "random_password" "jwt" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "jwt" {
  name                    = "${local.name}/jwt-secret"
  recovery_window_in_days = 0 # delete immediately on destroy (lets the name be reused)
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id     = aws_secretsmanager_secret.jwt.id
  secret_string = random_password.jwt.result
}
